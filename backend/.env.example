# ==============================================================================
# Dunda na Fes — Backend Configuration (.env.example)
# Copy this file to `.env` in `backend/` to customize local settings.
# All values below are the documented defaults if `.env` is omitted.
# ==============================================================================

# Server binding — MUST remain 127.0.0.1 (local-only rule)
HOST=127.0.0.1
PORT=3001

# Storage directories (relative to repository root, or absolute paths)
STORAGE_ROOT=../storage
STAGING_DIR=../storage/staging
LIBRARY_DIR=../storage/library
TEMP_DIR=../storage/temp
MODELS_DIR=../storage/models
DB_PATH=../storage/db/dunda.sqlite

# Upload limits
MAX_UPLOAD_SIZE_MB=100

# Audio separation settings
PYTHON_EXECUTABLE=../separator/.venv/Scripts/python.exe
SEPARATOR_SCRIPT=../separator/separate.py
DEFAULT_MODEL=UVR-MDX-NET-Inst_HQ_3.onnx
FALLBACK_MODEL=Kim_Vocal_2.onnx

# Optional explicit path to ffmpeg / ffprobe if not on system PATH
FFMPEG_PATH=
FFPROBE_PATH=
